{
    "name": "silin/magento-perf-check",
    "description": "Static analysis for Magento 2 and Mage-OS performance and Full Page Cache anti-patterns: PHPStan rules plus XML checks.",
    "license": "MIT",
    "homepage": "https://github.com/SilinMykola/magento-perf-check",
    "authors": [
        {
            "name": "Mykola Silin",
            "homepage": "https://github.com/SilinMykola"
        }
    ],
    "support": {
        "issues": "https://github.com/SilinMykola/magento-perf-check/issues",
        "source": "https://github.com/SilinMykola/magento-perf-check"
    },
    "type": "phpstan-extension",
    "keywords": [
        "magento",
        "mage-os",
        "phpstan",
        "performance",
        "full-page-cache",
        "static-analysis"
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "nette/neon": "^3.4",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "webonyx/graphql-php": "^14.11 || ^15.0"
    },
    "require-dev": {
        "composer/semver": "^3.4",
        "justinrainbow/json-schema": "^6.13",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^10.5",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "bitexpert/phpstan-magento": "Resolves types of generated proxies and extension attributes when generated/code is not available"
    },
    "autoload": {
        "psr-4": {
            "Silin\\MagentoPerfCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silin\\MagentoPerfCheck\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/PhpStan/Fixtures/",
            "tests/Integration/Fixtures/phpstan-cli/"
        ]
    },
    "bin": [
        "bin/magento-perf-check"
    ],
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist"
    }
}
