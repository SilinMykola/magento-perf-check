parameters:
    magentoPerf:
        # Set by magento-perf-check to count getFirstItem() calls it could not type.
        reportUntypedReceivers: false
        # Magento project whose configuration (di.xml, events.xml, ...) rules may consult.
        projectRoot: %currentWorkingDirectory%

parametersSchema:
    magentoPerf: structure([
        reportUntypedReceivers: bool()
        projectRoot: string()
    ])

services:
    -
        class: MagentoPerfRules\PhpStan\ProjectIndexProvider
        arguments:
            projectRoot: %magentoPerf.projectRoot%
    -
        class: MagentoPerfRules\PhpStan\LoopContextVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: MagentoPerfRules\PhpStan\ObjectManagerFallbackVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: MagentoPerfRules\PhpStan\ControllerResultVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: MagentoPerfRules\PhpStan\CollectionStateVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: MagentoPerfRules\PhpStan\Rule\GetFirstItemWithoutLimitRule
        arguments:
            reportUntypedReceivers: %magentoPerf.reportUntypedReceivers%
        tags:
            - phpstan.rules.rule

rules:
    - MagentoPerfRules\PhpStan\Rule\ModelLoadInLoopRule
    - MagentoPerfRules\PhpStan\Rule\CollectionCountRule
    - MagentoPerfRules\PhpStan\Rule\CollectionInLoopRule
    - MagentoPerfRules\PhpStan\Rule\SaveInLoopRule
    - MagentoPerfRules\PhpStan\Rule\CompositeTypeInLoopRule
    - MagentoPerfRules\PhpStan\Rule\SessionWithoutProxyRule
    - MagentoPerfRules\PhpStan\Rule\ConstructorWorkRule
    - MagentoPerfRules\PhpStan\Rule\DispatchInConstructorRule
    - MagentoPerfRules\PhpStan\Rule\ObjectManagerUsageRule
    - MagentoPerfRules\PhpStan\Rule\ScopePrivateRule
    - MagentoPerfRules\PhpStan\Rule\SessionDataInBlockRule
    - MagentoPerfRules\PhpStan\Rule\NoCacheHeadersRule
    - MagentoPerfRules\PhpStan\Rule\StateChangeOnGetRule
    - MagentoPerfRules\PhpStan\Rule\CacheCleanRule
    - MagentoPerfRules\PhpStan\Rule\FullReindexRule
    - MagentoPerfRules\PhpStan\Rule\AroundPluginRule
    - MagentoPerfRules\PhpStan\Rule\CreateBlockInTemplateRule
    - MagentoPerfRules\PhpStan\Rule\RecurringSetupRule
