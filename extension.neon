parameters:
    magentoPerf:
        # Set by magento-perf-check to count getFirstItem() calls it could not type.
        reportUntypedReceivers: false
        # Magento project whose configuration (di.xml, events.xml, ...) rules may consult.
        projectRoot: %currentWorkingDirectory%
        # Set by magento-perf-check: changes with the XML behind the project index, so PHPStan drops stale results.
        indexFingerprint: ''

parametersSchema:
    magentoPerf: structure([
        reportUntypedReceivers: bool()
        projectRoot: string()
        indexFingerprint: string()
    ])

services:
    -
        class: Silin\MagentoPerfCheck\PhpStan\ProjectIndexProvider
        arguments:
            projectRoot: %magentoPerf.projectRoot%
    -
        class: Silin\MagentoPerfCheck\PhpStan\FactoryCreateTypeExtension
        tags:
            - phpstan.broker.expressionTypeResolverExtension
    -
        class: Silin\MagentoPerfCheck\PhpStan\LoopContextVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Silin\MagentoPerfCheck\PhpStan\LoopExitVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Silin\MagentoPerfCheck\PhpStan\ObjectManagerFallbackVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Silin\MagentoPerfCheck\PhpStan\ControllerResultVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Silin\MagentoPerfCheck\PhpStan\ConditionalContextVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Silin\MagentoPerfCheck\PhpStan\IndexerModeVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Silin\MagentoPerfCheck\PhpStan\CollectionStateVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor

rules:
    - Silin\MagentoPerfCheck\PhpStan\Rule\ModelLoadInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\CollectionCountRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\CollectionInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\SaveInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\CompositeTypeInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\SessionWithoutProxyRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\DispatchInConstructorRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\ObjectManagerUsageRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\ScopePrivateRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\NoCacheHeadersRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\StateChangeOnGetRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\CacheCleanRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\FullReindexRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\CreateBlockInTemplateRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\RecurringSetupRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\AroundPluginRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\RepositoryListInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\ResourceLoadInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\CategoryIdsInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\DirectReindexRule
