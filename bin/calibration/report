#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Computes precision from the graded samples in docs/calibration/graded/ and writes
 * docs/calibration.md (change m2-calibration, design D3).
 *
 *   report           write docs/calibration.md and print the decisions
 *   report --check   validate the round 1 grading tables and print the decisions
 *   report --print   print the page instead of writing it (a test compares it with docs/calibration.md)
 */

require __DIR__ . '/../../vendor/autoload.php';

use Silin\MagentoPerfCheck\Rule\Severity;

const ROOT = __DIR__ . '/../..';
const VERDICTS = ['TP', 'TP-low', 'FP', 'unclear'];
const MIN_GRADED = 10;
const MIN_IMPACT_SHARE = 0.5;

/**
 * The default set and its severities when round 1 was graded (2026-10-24), in catalog order. This page
 * records that round: later rounds moved rules in and out of the default set and changed severities,
 * so reading the current catalog would recompute old decisions against new severities.
 */
const ROUND_1 = [
    'X-LAY-01' => Severity::Warning,
    'P-LOOP-01' => Severity::Error,
    'P-COL-02' => Severity::Error,
    'P-COL-01' => Severity::Warning,
    'P-LOOP-02' => Severity::Error,
    'P-LOOP-03' => Severity::Warning,
    'P-LOOP-07' => Severity::Warning,
    'P-DI-01' => Severity::Error,
    'P-DI-02' => Severity::Warning,
    'P-DI-03' => Severity::Error,
    'P-DI-06' => Severity::Warning,
    'P-FPC-01' => Severity::Error,
    'P-FPC-02' => Severity::Warning,
    'P-FPC-05' => Severity::Warning,
    'P-FPC-06' => Severity::Error,
    'P-FPC-09' => Severity::Error,
    'P-FPC-10' => Severity::Error,
    'P-PLG-01' => Severity::Warning,
    'T-01' => Severity::Warning,
    'X-SETUP-01' => Severity::Warning,
    'X-LAY-02' => Severity::Error,
    'X-EVT-01' => Severity::Warning,
    'X-EVT-02' => Severity::Warning,
    'X-EVT-03' => Severity::Warning,
    'X-SEC-01' => Severity::Error,
    'X-MQ-01' => Severity::Warning,
    'X-IDX-01' => Severity::Warning,
    'X-DB-01' => Severity::Error,
    'X-GQL-01' => Severity::Error,
];

/**
 * The runs round 1 was sampled from. Rerunning "bin/calibration/run core" rewrites docs/calibration/runs/,
 * so the page keeps what round 1 used: run, project, paths, wall time, peak RSS, tool commit, date.
 */
const ROUND_1_RUNS = [
    ['core', 'var/corpus/magento', 'vendor/magento', 128, 3627, '4f32744', '2026-10-24'],
    ['packagist', 'var/corpus/magento', 'app/code', 13, 2772, '4f32744', '2026-10-24'],
];

/**
 * @return array{rows: list<array{n: int, location: string, verdict: string, reason: string, recheck: bool, owner: string}>, total: int}
 */
function parseGrades(string $file): array
{
    $content = (string) file_get_contents($file);
    $total = preg_match('/^(\d+) of (\d+) findings/m', $content, $m) === 1 ? (int) $m[2] : 0;
    $section = substr($content, (int) strpos($content, "## Grades"));
    $rows = [];
    foreach (explode("\n", $section) as $line) {
        if (preg_match('/^\|\s*(\d+)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|$/', $line, $c) !== 1) {
            continue;
        }
        $rows[] = [
            'n' => (int) $c[1],
            'location' => $c[2],
            'verdict' => $c[3],
            'reason' => $c[4],
            'recheck' => $c[5] === 're-check',
            'owner' => $c[6],
        ];
    }

    return ['rows' => $rows, 'total' => $total];
}

/**
 * @return list<string> problems in a grading table
 */
function problems(string $id, array $rows): array
{
    $problems = [];
    foreach ($rows as $row) {
        if (!in_array($row['verdict'], VERDICTS, true)) {
            $problems[] = sprintf('%s #%d: verdict "%s" is not one of %s', $id, $row['n'], $row['verdict'], implode(', ', VERDICTS));
        }
        if ($row['reason'] === '') {
            $problems[] = sprintf('%s #%d: no reason', $id, $row['n']);
        }
        if ($row['owner'] !== '' && $row['owner'] !== '✓' && preg_match('/^was (TP|TP-low|FP|unclear)$/', $row['owner']) !== 1) {
            $problems[] = sprintf('%s #%d: owner column must be empty, ✓ or "was <verdict>"', $id, $row['n']);
        }
    }

    return $problems;
}

/**
 * Thresholds from the calibration spec: precision decides the status and the severity,
 * then an impact share below MIN_IMPACT_SHARE lowers the severity by one more step.
 */
function decide(Severity $severity, int $graded, ?float $precision, ?float $impactShare): string
{
    if ($graded < MIN_GRADED || $precision === null) {
        return 'insufficient data';
    }
    $target = match ($severity) {
        Severity::Error => $precision >= 0.90 ? Severity::Error : ($precision >= 0.75 ? Severity::Warning : null),
        Severity::Warning => $precision >= 0.75 ? Severity::Warning : null,
        Severity::Info => Severity::Info,
    };
    if ($target === null) {
        return 'experimental';
    }
    if ($impactShare !== null && $impactShare < MIN_IMPACT_SHARE) {
        $target = match ($target) {
            Severity::Error => Severity::Warning,
            Severity::Warning, Severity::Info => Severity::Info,
        };
    }

    return $target === $severity ? 'kept' : 'downgraded to ' . $target->value;
}

$check = in_array('--check', $argv, true);
$results = [];
$allProblems = [];
foreach (ROUND_1 as $id => $severity) {
    $file = ROOT . '/docs/calibration/graded/' . $id . '.md';
    if (!is_file($file)) {
        $results[$id] = ['severity' => $severity, 'total' => 0, 'counts' => array_fill_keys(VERDICTS, 0), 'rechecked' => 0, 'changed' => 0, 'graded' => 0, 'precision' => null, 'impactShare' => null];
        continue;
    }
    $parsed = parseGrades($file);
    array_push($allProblems, ...problems($id, $parsed['rows']));
    $counts = array_fill_keys(VERDICTS, 0);
    $rechecked = 0;
    $changed = 0;
    foreach ($parsed['rows'] as $row) {
        if (isset($counts[$row['verdict']])) {
            ++$counts[$row['verdict']];
        }
        if ($row['owner'] !== '') {
            ++$rechecked;
            $changed += str_starts_with($row['owner'], 'was ') ? 1 : 0;
        }
    }
    $graded = $counts['TP'] + $counts['TP-low'] + $counts['FP'];
    $results[$id] = [
        'severity' => $severity,
        'total' => $parsed['total'],
        'counts' => $counts,
        'rechecked' => $rechecked,
        'changed' => $changed,
        'graded' => $graded,
        'precision' => $graded > 0 ? ($counts['TP'] + $counts['TP-low']) / $graded : null,
        'impactShare' => $counts['TP'] + $counts['TP-low'] > 0 ? $counts['TP'] / ($counts['TP'] + $counts['TP-low']) : null,
    ];
}

// Later rounds keep their grading in docs/calibration/graded/round-N/; a file here for another rule is a mistake.
foreach (glob(ROOT . '/docs/calibration/graded/*.md') ?: [] as $file) {
    if (!isset(ROUND_1[basename($file, '.md')])) {
        $allProblems[] = basename($file) . ': not a rule of round 1; later rounds grade in docs/calibration/graded/round-N/';
    }
}
if ($allProblems !== []) {
    fwrite(STDERR, implode("\n", $allProblems) . "\n");
    exit(1);
}
$corpus = json_decode((string) file_get_contents(ROOT . '/docs/calibration/corpus.json'), true, 512, JSON_THROW_ON_ERROR);

$rows = '';
$decisions = [];
foreach ($results as $id => $r) {
    $decision = $r['total'] === 0 ? 'no findings in the corpus' : decide($r['severity'], $r['graded'], $r['precision'], $r['impactShare']);
    $decisions[$id] = $decision;
    $rows .= sprintf(
        "| [%s](rules/%s.md) | %s | %d | %d | %d | %d | %d | %d | %s | %s | %d (%d changed) | %s |\n",
        $id,
        $id,
        $r['severity']->value,
        $r['total'],
        array_sum($r['counts']),
        $r['counts']['TP'],
        $r['counts']['TP-low'],
        $r['counts']['FP'],
        $r['counts']['unclear'],
        $r['precision'] === null ? '–' : sprintf('%.0f %%', $r['precision'] * 100),
        $r['impactShare'] === null ? '–' : sprintf('%.0f %%', $r['impactShare'] * 100),
        $r['rechecked'],
        $r['changed'],
        $decision,
    );
}

if ($check) {
    echo "grading tables are complete; decisions:\n";
    foreach ($decisions as $id => $decision) {
        echo sprintf("%-10s %s\n", $id, $decision);
    }
    exit(0);
}

$runs = '';
foreach (ROUND_1_RUNS as [$run, $project, $paths, $wallSeconds, $peakRssMb, $toolCommit, $date]) {
    $runs .= sprintf("| %s | `%s` | `--paths=%s` | %d s | %d MB | %s | %s |\n", $run, $project, $paths, $wallSeconds, $peakRssMb, $toolCommit, $date);
}

$modules = count($corpus['packagist']['modules'] ?? []);
$mageOs = ($corpus['mage-os']['included'] ?? true) === false
    ? '- Not included: Mage-OS. ' . $corpus['mage-os']['reason']
    : '- Mage-OS ' . $corpus['mage-os']['version'] . ' (`vendor/mage-os`)';
$extended = isset($corpus['extended'])
    ? sprintf(
        "\n- Not used on this page: a second part, `extended`, with the next %d modules and Hyvä Theme %s, which [round 6](https://github.com/SilinMykola/magento-perf-check/blob/main/docs/calibration/round-6.md) uses for the experimental rules",
        count($corpus['extended']['modules']),
        $corpus['extended']['hyva'][count($corpus['extended']['hyva']) - 1]['version'],
    )
    : '';
$github = isset($corpus['github'])
    ? sprintf(
        "\n- Not used on this page: a third part, `github`, with %d modules from the most-starred GitHub repositories with the topic `magento2-module`, which the [third held-out check](https://github.com/SilinMykola/magento-perf-check/blob/main/docs/calibration/held-out-3.md) uses",
        count($corpus['github']['modules']),
    )
    : '';
$report = <<<MD
    # Calibration

    How precise is each rule of the default set on real Magento code? This page is generated by `bin/calibration/report` from the graded samples in [`calibration/graded/`](https://github.com/SilinMykola/magento-perf-check/tree/main/docs/calibration/graded/); do not edit it by hand.

    ## Corpus

    Defined in [`calibration/corpus.json`](https://github.com/SilinMykola/magento-perf-check/blob/main/docs/calibration/corpus.json), with versions and archive checksums:

    - Magento {$corpus['magento']['version']} core (`vendor/magento`)
    - {$modules} most-downloaded `magento2-module` packages from Packagist that install on that version (`app/code` of the corpus copy)
    {$mageOs}{$extended}{$github}

    Test code is excluded (the tool's default), and so are `*-sample-data` modules at sampling time.

    | Run | Project | Paths | Wall time | Peak RSS | Tool commit | Date |
    |---|---|---|---|---|---|---|
    {$runs}
    ## Method

    1. Every default rule ran on the corpus. Up to 30 findings per rule were drawn with a fixed seed (20261023, `bin/calibration/sample`).
    2. Each sampled finding was graded by reading the code around it:
       - `TP`: the rule's claim holds;
       - `TP-low`: it holds, but the impact is negligible;
       - `FP`: the claim does not hold;
       - `unclear`.
    3. Each finding was graded once, by a single grader. The "Owner re-checked" column shows how many verdicts the owner reviewed and how many of those were changed; the owner decided on 2026-10-24 not to re-check this round.
    4. Precision = (TP + TP-low) / (TP + TP-low + FP): how often the rule is right. `unclear` findings are excluded.
    5. Impact share = TP / (TP + TP-low): how often a correct finding matters.
    6. Thresholds (SPEC section 7):
       - `error` stays at ≥ 90 % precision, becomes `warning` at 75–90 %, and moves to experimental below;
       - `warning` stays at ≥ 75 % precision and moves to experimental below;
       - a rule that stays in the default set with an impact share below 50 % goes one more step down: `error` to `warning`, `warning` to `info`;
       - with fewer than 10 graded findings, the rule keeps its severity and is marked "insufficient data".

    ## Results

    Rules changed after this report were measured again: see [round 2](https://github.com/SilinMykola/magento-perf-check/blob/main/docs/calibration/round-2.md), whose decisions replace the ones below.

    | Rule | Severity | Findings | Sampled | TP | TP-low | FP | Unclear | Precision | Impact share | Owner re-checked | Decision |
    |---|---|---|---|---|---|---|---|---|---|---|---|
    {$rows}
    Recurring false-positive patterns that need a rule change are listed in [`calibration/follow-ups.md`](https://github.com/SilinMykola/magento-perf-check/blob/main/docs/calibration/follow-ups.md).

    ## Limitations

    - With up to 30 findings per rule, precision has a wide margin of error. Read it together with the counts, not as an exact figure.
    - Only reported findings are judged. Missed findings (recall) are not measured.
    - `TP-low` is a judgement about impact without measuring time or memory.
    - Every verdict comes from one grader, without a second review. A grader who knows the rules' logic may lean towards their claims.
    - The corpus is open-source code. Project code may use patterns the corpus does not contain.

    MD;
if (in_array('--print', $argv, true)) {
    echo $report;
    exit(0);
}
file_put_contents(ROOT . '/docs/calibration.md', $report);

foreach ($decisions as $id => $decision) {
    echo sprintf("%-10s %s\n", $id, $decision);
}
