#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Builds the calibration corpus under var/corpus/ (change m2-calibration, design D1).
 *
 *   build-corpus magento     copy of the Magento project at CORPUS_SOURCE_PROJECT, an absolute path (read-only source)
 *   build-corpus packagist   the 25 most-downloaded installable magento2-module packages
 *   build-corpus extended    a second copy with the next 100 modules and Hyvä Theme (change extend-calibration-corpus)
 *   build-corpus github      a hard-linked copy of extended with 50 GitHub modules, cloned into
 *                            var/corpus/github-clones (change add-github-corpus)
 *   build-corpus mage-os     composer install of mage-os/project-community-edition
 *   build-corpus --clean     remove var/corpus
 *   build-corpus pick <name> show which version of a package would be taken, and why
 *
 * docs/calibration/corpus.json records what was built.
 */

require __DIR__ . '/../../vendor/autoload.php';
require __DIR__ . '/registration-check.php';

use Composer\Semver\Semver;
use Composer\Semver\VersionParser;

const ROOT = __DIR__ . '/../..';
const CORPUS = ROOT . '/var/corpus';
const MANIFEST = ROOT . '/docs/calibration/corpus.json';
const MODULE_COUNT = 25;
const EXTENDED_COUNT = 100;
const GITHUB_COUNT = 50;
const TARGET_PHP = '8.4.0';

function fail(string $message): never
{
    fwrite(STDERR, "build-corpus: $message\n");
    exit(1);
}

function run(array $command, ?string $cwd = null): string
{
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $cwd);
    if (!is_resource($process)) {
        fail('cannot start ' . $command[0]);
    }
    $out = (string) stream_get_contents($pipes[1]);
    $err = (string) stream_get_contents($pipes[2]);
    if (proc_close($process) !== 0) {
        fail(implode(' ', $command) . " failed:\n" . trim($err . "\n" . $out));
    }

    return $out;
}

/**
 * @return array<string, mixed>
 */
function manifest(): array
{
    if (!is_file(MANIFEST)) {
        return ['description' => 'Calibration corpus (change m2-calibration). Rebuild with bin/calibration/build-corpus.'];
    }

    return json_decode((string) file_get_contents(MANIFEST), true, 512, JSON_THROW_ON_ERROR);
}

/**
 * @param array<string, mixed> $manifest
 */
function saveManifest(array $manifest): void
{
    if (!is_dir(dirname(MANIFEST))) {
        mkdir(dirname(MANIFEST), 0777, true);
    }
    file_put_contents(MANIFEST, json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
}

/**
 * @return array<string, mixed>
 */
function fetchJson(string $url): array
{
    $context = stream_context_create(['http' => ['timeout' => 60, 'user_agent' => 'magento-perf-check calibration']]);
    $body = @file_get_contents($url, false, $context);
    if ($body === false) {
        fail("cannot fetch $url");
    }

    return json_decode($body, true, 512, JSON_THROW_ON_ERROR);
}

/**
 * Package name => version, from the copy's composer.lock (what modules must be compatible with).
 *
 * @return array<string, string>
 */
function installedVersions(): array
{
    $lock = json_decode((string) file_get_contents(CORPUS . '/magento/composer.lock'), true, 512, JSON_THROW_ON_ERROR);
    $versions = [];
    foreach ([...$lock['packages'], ...$lock['packages-dev']] as $package) {
        $versions[$package['name']] = $package['version'];
    }

    return $versions;
}

function buildMagento(): void
{
    $source = rtrim((string) getenv('CORPUS_SOURCE_PROJECT'), '/');
    if ($source === '') {
        fail('set CORPUS_SOURCE_PROJECT to the absolute path of the Magento project to copy');
    }
    $marker = tempnam(sys_get_temp_dir(), 'corpus-marker');
    if (!is_dir(CORPUS)) {
        mkdir(CORPUS, 0777, true);
    }
    run([
        'rsync', '-a', '--delete',
        '--exclude', '/var/', '--exclude', '/pub/static/', '--exclude', '/pub/media/', '--exclude', '/.ddev/',
        '--exclude', '/app/code/',
        $source . '/', CORPUS . '/magento/',
    ]);
    mkdir(CORPUS . '/magento/app/code', 0777, true);
    $changed = trim(run(['find', $source, '-newer', (string) $marker]));
    unlink((string) $marker);
    if ($changed !== '') {
        fail("the source project changed during the copy:\n$changed");
    }
    $base = json_decode((string) file_get_contents($source . '/vendor/magento/magento2-base/composer.json'), true);
    $manifest = manifest();
    $manifest['magento'] = [
        'source' => 'copy of a local Magento project (app/code of the source left out)',
        'version' => $base['version'] ?? 'unknown',
        'paths' => ['vendor/magento'],
    ];
    saveManifest($manifest);
    echo "magento: copied to var/corpus/magento\n";
}

/**
 * Newest stable version of a package whose requirements the corpus satisfies.
 *
 * @param array<string, string> $installed
 * @return array{0: ?array<string, mixed>, 1: string} version data or null, and the reason when null
 */
function pickVersion(string $name, array $installed): array
{
    $data = fetchJson('https://repo.packagist.org/p2/' . $name . '.json');
    $versions = $data['packages'][$name] ?? [];
    $last = 'no stable version';
    foreach ($versions as $version) {
        if (VersionParser::parseStability($version['version']) !== 'stable') {
            continue;
        }
        if (($version['type'] ?? '') !== 'magento2-module') {
            $last = 'type ' . ($version['type'] ?? 'none');
            continue;
        }
        $unmet = unmetRequirements($version['require'] ?? [], $installed, null);
        if ($unmet === []) {
            return [$version, ''];
        }
        $last = 'requires ' . implode(', ', array_slice($unmet, 0, 3));
    }

    return [null, $last];
}

/**
 * Requirements the copy does not meet. With $present null, only magento/*, laminas/*, symfony/* and php
 * are checked (Packagist parts); otherwise every package must be installed at a fitting version or be
 * one of the $present module packages (GitHub part).
 *
 * @param array<string, string> $require
 * @param array<string, string> $installed
 * @param ?list<string> $present
 * @return list<string>
 */
function unmetRequirements(array $require, array $installed, ?array $present): array
{
    $parser = new VersionParser();
    $unmet = [];
    foreach ($require as $dependency => $constraint) {
        if (!is_string($dependency) || !is_string($constraint)) {
            $unmet[] = 'a requirement that is not a string';
            continue;
        }
        try {
            $parser->parseConstraints($constraint);
        } catch (UnexpectedValueException) {
            $unmet[] = "$dependency with an invalid constraint";
            continue;
        }
        if ($dependency === 'php') {
            if (!Semver::satisfies(TARGET_PHP, $constraint)) {
                $unmet[] = "php $constraint";
            }
            continue;
        }
        if (str_starts_with($dependency, 'ext-') || str_starts_with($dependency, 'lib-')) {
            continue;
        }
        $checked = $present !== null
            || str_starts_with($dependency, 'magento/') || str_starts_with($dependency, 'laminas/') || str_starts_with($dependency, 'symfony/');
        if (!$checked || in_array($dependency, $present ?? [], true)) {
            continue;
        }
        if (!isset($installed[$dependency]) || !Semver::satisfies($parser->normalize($installed[$dependency]), $constraint)) {
            $unmet[] = "$dependency $constraint";
        }
    }

    return $unmet;
}

/**
 * @return array{name: string, reason: string}
 */
function skip(string $name, string $reason): array
{
    fwrite(STDERR, "skip $name: $reason\n");

    return ['name' => $name, 'reason' => $reason];
}

function moduleName(string $dir): ?string
{
    $moduleXml = $dir . '/etc/module.xml';
    if (!is_file($moduleXml)) {
        return null;
    }

    return preg_match('#<module\s[^>]*name\s*=\s*"([A-Za-z0-9]+_[A-Za-z0-9]+)"#', (string) file_get_contents($moduleXml), $m) === 1 ? $m[1] : null;
}

/**
 * Packagist packages of type magento2-module, most downloaded first.
 *
 * @return list<array<string, mixed>>
 */
function candidatesByDownloads(): array
{
    $candidates = [];
    for ($page = 1; $page <= 130; ++$page) {
        $result = fetchJson('https://packagist.org/search.json?type=magento2-module&per_page=100&page=' . $page);
        foreach ($result['results'] ?? [] as $package) {
            $candidates[] = $package;
        }
        if (!isset($result['next'])) {
            break;
        }
    }
    usort($candidates, static fn (array $a, array $b): int => $b['downloads'] <=> $a['downloads']);

    return $candidates;
}

/**
 * Downloads an archive to $file; checks the published SHA-1 when there is one.
 */
function download(string $url, string $file, string $sha1 = ''): ?string
{
    $archive = @file_get_contents($url, false, stream_context_create([
        // GitHub's zipball API rejects requests without a User-Agent.
        'http' => ['timeout' => 120, 'user_agent' => 'magento-perf-check calibration', 'follow_location' => 1],
    ]));
    if ($archive === false) {
        return 'download failed';
    }
    file_put_contents($file, $archive);
    if ($sha1 !== '' && sha1_file($file) !== $sha1) {
        return 'SHA-1 mismatch';
    }

    return null;
}

/**
 * The single top directory of an extracted archive, or the extraction directory itself.
 */
function archiveRoot(string $extract): string
{
    $entries = array_values(array_diff(scandir($extract) ?: [], ['.', '..']));

    return count($entries) === 1 && is_dir($extract . '/' . $entries[0]) ? $extract . '/' . $entries[0] : $extract;
}

/**
 * Besides registration.php, Magento's app/etc/registration_globlist.php makes the autoloader run
 * app/code/<Vendor>/<Module>/cli_commands.php. The analysis does not need it, so the copy leaves it out.
 *
 * @return list<string> the files removed
 */
function removeAutoloadedFiles(string $moduleDir): array
{
    $removed = [];
    foreach (['cli_commands.php'] as $file) {
        if (file_exists($moduleDir . '/' . $file) || is_link($moduleDir . '/' . $file)) {
            unlink($moduleDir . '/' . $file);
            $removed[] = $file;
        }
    }

    return $removed;
}

/** The registration.php that the autoloader would run: a regular file with only the standard call. */
function hasStandardRegistration(string $root): bool
{
    $file = $root . '/registration.php';

    return is_file($file) && !is_link($file) && isStandardRegistration((string) file_get_contents($file));
}

/**
 * Copies the most-downloaded installable modules into app/code of $project.
 *
 * @param list<string> $exclude package names to pass over
 * @return array{modules: list<array<string, mixed>>, skipped: list<array{name: string, reason: string}>}
 */
function selectModules(string $project, int $count, array $exclude, bool $hyvaPresent, bool $checkRegistration): array
{
    $installed = installedVersions();
    $modules = [];
    $skipped = [];
    $work = sys_get_temp_dir() . '/corpus-dist-' . getmypid();
    mkdir($work);
    // fail() exits; the downloads must not stay behind.
    register_shutdown_function(static function () use ($work): void {
        if (is_dir($work)) {
            exec('rm -rf ' . escapeshellarg($work));
        }
    });
    foreach (candidatesByDownloads() as $candidate) {
        if (count($modules) >= $count) {
            break;
        }
        $name = $candidate['name'];
        if (in_array($name, $exclude, true)) {
            continue;
        }
        if (($candidate['abandoned'] ?? false) !== false) {
            $skipped[] = skip($name, 'abandoned');
            continue;
        }
        if (str_starts_with($name, 'magento/')) {
            $skipped[] = skip($name, 'Magento core package');
            continue;
        }
        if (!$hyvaPresent && str_starts_with($name, 'hyva-themes/')) {
            $skipped[] = skip($name, 'needs the Hyvä theme stack');
            continue;
        }
        [$version, $reason] = pickVersion($name, $installed);
        if ($version === null || !isset($version['dist']['url'])) {
            $skipped[] = skip($name, $reason !== '' ? $reason : 'no dist archive');
            continue;
        }
        $zip = $work . '/' . str_replace('/', '_', $name) . '.zip';
        $failure = download($version['dist']['url'], $zip, $version['dist']['shasum'] ?? '');
        if ($failure !== null) {
            $skipped[] = skip($name, $failure);
            continue;
        }
        $extract = $work . '/' . str_replace('/', '_', $name);
        run(['unzip', '-q', '-o', $zip, '-d', $extract]);
        $root = archiveRoot($extract);
        // Some packages keep the module in src/.
        if (moduleName($root) === null && moduleName($root . '/src') !== null) {
            $root .= '/src';
        }
        $module = moduleName($root);
        if ($module === null) {
            $skipped[] = skip($name, 'no etc/module.xml at the package root');
            continue;
        }
        if ($checkRegistration && !hasStandardRegistration($root)) {
            $skipped[] = skip($name, 'registration.php is missing or holds more than the standard register() call');
            continue;
        }
        [$vendor, $short] = explode('_', $module, 2);
        $target = $project . '/app/code/' . $vendor . '/' . $short;
        if (is_dir($target)) {
            $skipped[] = skip($name, "module $module already present");
            continue;
        }
        if (!is_dir(dirname($target))) {
            mkdir(dirname($target), 0777, true);
        }
        run(['cp', '-R', $root, $target]);
        $entry = [
            'name' => $name,
            'version' => $version['version'],
            'module' => $module,
            'downloads' => $candidate['downloads'],
            'sha256' => hash_file('sha256', $zip),
        ];
        $removed = $checkRegistration ? removeAutoloadedFiles($target) : [];
        if ($removed !== []) {
            $entry['removed'] = $removed;
        }
        $modules[] = $entry;
        echo sprintf("%-45s %-10s %s\n", $name, $version['version'], $module);
    }
    run(['rm', '-rf', $work]);
    if (count($modules) < $count) {
        fail(sprintf('only %d installable modules found', count($modules)));
    }

    return ['modules' => $modules, 'skipped' => $skipped];
}

function buildPackagist(): void
{
    if (!is_dir(CORPUS . '/magento')) {
        fail('run "build-corpus magento" first');
    }
    $selection = selectModules(CORPUS . '/magento', MODULE_COUNT, [], false, false);
    $manifest = manifest();
    $manifest['packagist'] = [
        'selection' => sprintf('first %d packages of type magento2-module by downloads that are not abandoned and whose magento/*, laminas/*, symfony/* and php requirements the Magento copy satisfies (PHP %s)', MODULE_COUNT, TARGET_PHP),
        'date' => date('Y-m-d'),
        'path' => 'app/code',
        ...$selection,
    ];
    saveManifest($manifest);
}

/**
 * Hyvä Theme is not on Packagist; these are the tags that the default theme 1.5.3 requires
 * (design D4). Repository => [tag, target relative to the project]. The manifest records each tag's
 * commit, and a rebuild stops when a tag has moved.
 */
const HYVA = [
    'magento2-theme-module' => ['1.5.3', 'app/code/Hyva/Theme'],
    'magento2-base-layout-reset' => ['2.0.5', 'app/code/Hyva/BaseLayoutReset'],
    'magento2-email-module' => ['1.0.6', 'app/code/Hyva/Email'],
    'magento2-order-cancellation-webapi' => ['1.0.1', 'app/code/Hyva/OrderCancellationWebapi'],
    'magento2-default-theme' => ['1.5.3', 'app/design/frontend/Hyva/default'],
];

/**
 * @return list<array<string, string>>
 */
function installHyva(string $project): array
{
    $installed = [];
    $work = sys_get_temp_dir() . '/corpus-hyva-' . getmypid();
    mkdir($work);
    // fail() exits; the downloads must not stay behind.
    register_shutdown_function(static function () use ($work): void {
        if (is_dir($work)) {
            exec('rm -rf ' . escapeshellarg($work));
        }
    });
    foreach (HYVA as $repository => [$tag, $target]) {
        // The tag's commit pins the code; a generated archive of it need not stay byte-identical.
        $commit = (string) (fetchJson(sprintf('https://api.github.com/repos/hyva-themes/%s/commits/%s', $repository, $tag))['sha'] ?? '');
        if (preg_match('/^[0-9a-f]{40}$/', $commit) !== 1) {
            fail("hyva-themes/$repository $tag: no commit for the tag");
        }
        foreach (manifest()['extended']['hyva'] ?? [] as $known) {
            if ($known['name'] === 'hyva-themes/' . $repository && $known['version'] === $tag && ($known['commit'] ?? $commit) !== $commit) {
                fail("hyva-themes/$repository $tag: the tag now points at $commit, not at the commit in the manifest");
            }
        }
        $url = sprintf('https://codeload.github.com/hyva-themes/%s/tar.gz/%s', $repository, $commit);
        $archive = $work . '/' . $repository . '.tar.gz';
        $failure = download($url, $archive);
        if ($failure !== null) {
            fail("hyva-themes/$repository $tag: $failure");
        }
        $extract = $work . '/' . $repository;
        mkdir($extract);
        run(['tar', '-xzf', $archive, '-C', $extract]);
        $root = archiveRoot($extract);
        if (is_file($root . '/src/registration.php')) {
            $root .= '/src';
        }
        if (!hasStandardRegistration($root)) {
            fail("hyva-themes/$repository $tag: registration.php holds more than the standard register() call");
        }
        if (!is_dir(dirname($project . '/' . $target))) {
            mkdir(dirname($project . '/' . $target), 0777, true);
        }
        run(['cp', '-R', $root, $project . '/' . $target]);
        $entry = [
            'name' => 'hyva-themes/' . $repository,
            'version' => $tag,
            'commit' => $commit,
            'source' => $url,
            'path' => $target,
            'sha256' => hash_file('sha256', $archive),
        ];
        $removed = removeAutoloadedFiles($project . '/' . $target);
        if ($removed !== []) {
            $entry['removed'] = $removed;
        }
        $installed[] = $entry;
        echo sprintf("%-45s %-10s %s\n", 'hyva-themes/' . $repository, $tag, $target);
    }
    run(['rm', '-rf', $work]);

    return $installed;
}

function buildExtended(): void
{
    $first = manifest()['packagist']['modules'] ?? null;
    if (!is_dir(CORPUS . '/magento') || !is_array($first)) {
        fail('build the magento and packagist parts first');
    }
    $target = CORPUS . '/extended';
    if (is_dir($target)) {
        run(['rm', '-rf', $target]);
    }
    run(['rsync', '-a', '--exclude', '/app/code/', CORPUS . '/magento/', $target . '/']);
    mkdir($target . '/app/code', 0777, true);
    $hyva = installHyva($target);
    $selection = selectModules($target, EXTENDED_COUNT, array_column($first, 'name'), true, true);
    $manifest = manifest();
    $manifest['extended'] = [
        'selection' => sprintf('the next %d packages of type magento2-module by downloads after the packagist part, chosen the same way, Hyvä packages included; a package whose registration.php holds more than the standard register() call is skipped', EXTENDED_COUNT),
        'date' => date('Y-m-d'),
        'paths' => ['app/code', 'app/design'],
        'hyva' => $hyva,
        ...$selection,
    ];
    saveManifest($manifest);
}

/**
 * GitHub repositories with the topic magento2-module, most stars first (design D2). Pages are read only
 * as they are needed: the search API allows 10 requests a minute without a token.
 *
 * @return Generator<int, array<string, mixed>>
 */
function githubCandidates(): Generator
{
    for ($page = 1; $page <= 10; ++$page) {
        $result = fetchJson('https://api.github.com/search/repositories?q=' . rawurlencode('topic:magento2-module archived:false fork:false')
            . '&sort=stars&order=desc&per_page=100&page=' . $page);
        yield from $result['items'] ?? [];
        if (count($result['items'] ?? []) < 100) {
            return;
        }
    }
}

function buildGithub(): void
{
    // Kept between builds (design D3): an existing clone is reused without a fetch.
    $clones = CORPUS . '/github-clones';
    $manifest = manifest();
    if (!is_dir(CORPUS . '/extended') || !isset($manifest['extended']['modules'])) {
        fail('build the extended part first');
    }
    $present = [
        ...array_column($manifest['packagist']['modules'] ?? [], 'name'),
        ...array_column($manifest['extended']['modules'], 'name'),
        ...array_column($manifest['extended']['hyva'] ?? [], 'name'),
    ];
    $target = CORPUS . '/github';
    if (is_dir($target)) {
        run(['rm', '-rf', $target]);
    }
    // Hard links to extended and to the modules of the packagist part (design D1): the part costs only its
    // new modules, and both earlier parts can provide what a new module requires.
    run(['rsync', '-a', '--link-dest=' . realpath(CORPUS . '/extended'), CORPUS . '/extended/', $target . '/']);
    run(['rsync', '-a', '--ignore-existing', '--link-dest=' . realpath(CORPUS . '/magento/app/code'), CORPUS . '/magento/app/code/', $target . '/app/code/']);
    $installed = installedVersions();
    putenv('GIT_TERMINAL_PROMPT=0');
    $modules = [];
    $skipped = [];
    foreach (githubCandidates() as $candidate) {
        if (count($modules) >= GITHUB_COUNT) {
            break;
        }
        $repository = (string) $candidate['full_name'];
        $clone = $clones . '/' . $repository;
        if (!is_dir($clone . '/.git')) {
            if (!is_dir(dirname($clone))) {
                mkdir(dirname($clone), 0777, true);
            }
            // A clone goes to its place only when complete, so an interrupted one is not reused later.
            // A transfer slower than 1 KB/s for a minute is given up rather than left to hang.
            $partial = $clone . '.partial';
            exec('rm -rf ' . escapeshellarg($partial));
            $output = [];
            exec('git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 clone --quiet --depth 1 '
                . escapeshellarg('https://github.com/' . $repository . '.git') . ' ' . escapeshellarg($partial) . ' 2>&1', $output, $code);
            if ($code !== 0 || !rename($partial, $clone)) {
                exec('rm -rf ' . escapeshellarg($partial));
                $skipped[] = skip($repository, 'git clone failed');
                continue;
            }
        }
        // A link could pull a file from outside the clone into the analyzed tree, and into a public report.
        if (trim(run(['find', $clone, '-path', $clone . '/.git', '-prune', '-o', '-type', 'l', '-print'])) !== '') {
            $skipped[] = skip($repository, 'contains a symbolic link');
            continue;
        }
        $moduleRoot = $clone;
        if (moduleName($moduleRoot) === null && moduleName($moduleRoot . '/src') !== null) {
            $moduleRoot .= '/src';
        }
        $module = moduleName($moduleRoot);
        if ($module === null) {
            $skipped[] = skip($repository, 'no etc/module.xml at the repository root or in src/');
            continue;
        }
        $composer = json_decode((string) @file_get_contents($clone . '/composer.json'), true);
        if (!is_array($composer) || ($composer['type'] ?? '') !== 'magento2-module') {
            $skipped[] = skip($repository, 'no composer.json of type magento2-module');
            continue;
        }
        $name = (string) ($composer['name'] ?? '');
        if (in_array($name, $present, true)) {
            $skipped[] = skip($repository, "package $name already in the corpus");
            continue;
        }
        [$vendor, $short] = explode('_', $module, 2);
        $destination = $target . '/app/code/' . $vendor . '/' . $short;
        if (is_dir($destination)) {
            $skipped[] = skip($repository, "module $module already present");
            continue;
        }
        $require = $composer['require'] ?? [];
        $unmet = is_array($require) ? unmetRequirements($require, $installed, $present) : ['a require that is not a list'];
        if ($unmet !== []) {
            $skipped[] = skip($repository, 'requires ' . implode(', ', array_slice($unmet, 0, 3)));
            continue;
        }
        if (!hasStandardRegistration($moduleRoot)) {
            $skipped[] = skip($repository, 'registration.php is missing or holds more than the standard register() call');
            continue;
        }
        if (!is_dir(dirname($destination))) {
            mkdir(dirname($destination), 0777, true);
        }
        run(['rsync', '-a', '--exclude', '/.git/', $moduleRoot . '/', $destination . '/']);
        $entry = [
            'repository' => $repository,
            'name' => $name,
            'module' => $module,
            'stars' => $candidate['stargazers_count'],
            'commit' => trim(run(['git', '-C', $clone, 'rev-parse', 'HEAD'])),
            'path' => 'app/code/' . $vendor . '/' . $short,
        ];
        $removed = removeAutoloadedFiles($destination);
        if ($removed !== []) {
            $entry['removed'] = $removed;
        }
        $modules[] = $entry;
        $present[] = $name;
        echo sprintf("%-55s %s\n", $repository, $module);
    }
    if (count($modules) < GITHUB_COUNT) {
        fail(sprintf('only %d modules found', count($modules)));
    }
    $manifest['github'] = [
        'selection' => sprintf('the %d most-starred GitHub repositories with the topic magento2-module, not archived and not forks, that hold one module of type magento2-module not yet in the corpus, whose requirements the copy meets (PHP %s) and whose registration.php is standard; default branch, cloned with --depth 1', GITHUB_COUNT, TARGET_PHP),
        'date' => date('Y-m-d'),
        'base' => 'hard-linked copy of the extended part',
        'modules' => $modules,
        'skipped' => $skipped,
    ];
    saveManifest($manifest);
}

function buildMageOs(): void
{
    $target = CORPUS . '/mage-os';
    if (is_dir($target)) {
        run(['rm', '-rf', $target]);
    }
    // Fewer parallel downloads: with the default, an install from repo.mage-os.org once hung on
    // stalled connections for two hours.
    putenv('COMPOSER_MAX_PARALLEL_HTTP=4');
    run([
        'composer', 'create-project', '--no-interaction', '--no-progress', '--no-scripts',
        '--ignore-platform-req=php', '--repository-url=https://repo.mage-os.org/',
        'mage-os/project-community-edition', $target,
    ]);
    if (!is_dir($target . '/app/etc')) {
        mkdir($target . '/app/etc', 0777, true);
    }
    $lock = json_decode((string) file_get_contents($target . '/composer.lock'), true, 512, JSON_THROW_ON_ERROR);
    $version = 'unknown';
    foreach ($lock['packages'] as $package) {
        if ($package['name'] === 'mage-os/magento2-base') {
            $version = $package['version'];
        }
    }
    $manifest = manifest();
    $manifest['mage-os'] = [
        'source' => 'composer create-project mage-os/project-community-edition from https://repo.mage-os.org/ (--no-scripts, --ignore-platform-req=php)',
        'version' => $version,
        'paths' => ['vendor/mage-os'],
    ];
    saveManifest($manifest);
    echo "mage-os: $version in var/corpus/mage-os\n";
}

$command = $argv[1] ?? '';
match ($command) {
    'magento' => buildMagento(),
    'packagist' => buildPackagist(),
    'extended' => buildExtended(),
    'github' => buildGithub(),
    'mage-os' => buildMageOs(),
    '--clean' => run(['rm', '-rf', CORPUS]),
    'pick' => (static function () use ($argv): void {
        [$version, $reason] = pickVersion($argv[2] ?? fail('pick needs a package name'), installedVersions());
        echo $version !== null ? $version['version'] . "\n" : "none: $reason\n";
    })(),
    default => fail('usage: build-corpus magento|packagist|extended|github|mage-os|--clean'),
};
