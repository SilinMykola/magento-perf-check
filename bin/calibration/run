#!/usr/bin/env bash
# Runs magento-perf-check on the three parts of the calibration corpus and stores the
# JSON reports, with the tool commit, wall time and peak RSS, in docs/calibration/runs/.
# Usage: run [core] [packagist] [extended] [mage-os]   (no argument: all of them)
# The extended run enables the experimental rules too and writes to runs/extended/, apart from the
# round 1 runs that bin/calibration/sample and report read (change extend-calibration-corpus).
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd -P)"
out="$root/docs/calibration/runs"
mkdir -p "$out"
commit="$(git -C "$root" rev-parse --short HEAD)"

# name|project|paths
runs=(
    "core|var/corpus/magento|vendor/magento"
    "packagist|var/corpus/magento|app/code"
    "extended|var/corpus/extended|app/code,app/design"
    "mage-os|var/corpus/mage-os|vendor/mage-os"
)
# Mage-OS is not part of the M2 corpus (docs/calibration/corpus.json); run it only when installed.

# Optional arguments select runs by name, e.g. "run core packagist".
selected=" $* "
for run in "${runs[@]}"; do
    IFS='|' read -r name project paths <<< "$run"
    if [ $# -gt 0 ] && [[ "$selected" != *" $name "* ]]; then
        continue
    fi
    if [ ! -f "$root/$project/vendor/autoload.php" ]; then
        echo "skipping $name: $project is not installed" >&2
        continue
    fi
    config=()
    out="$root/docs/calibration/runs"
    if [ "$name" = extended ]; then
        out="$out/extended"
        mkdir -p "$out"
        config_dir="$(mktemp -d)"
        # The directory goes also when the generator below fails under set -e.
        trap 'rm -rf "$config_dir"' EXIT
        config_file="$config_dir/all-rules.neon"
        php -r 'require $argv[1] . "/vendor/autoload.php";
            $rules = "";
            foreach (require $argv[1] . "/src/Rule/catalog.php" as $rule) {
                if ($rule->status === Silin\MagentoPerfCheck\Rule\RuleStatus::Experimental) {
                    $rules .= "        " . $rule->id . ":\n            enabled: true\n";
                }
            }
            echo "magentoPerf:\n    rules:\n" . $rules;' "$root" > "$config_file"
        config=(--config="$config_file")
    fi
    start=$(date +%s)
    php "$root/bin/magento-perf-check" --project="$root/$project" --paths="$paths" ${config[@]+"${config[@]}"} --format=json > "$out/$name.json" &
    pid=$!
    peak=0
    # Sum the RSS of the command and its children (PHPStan workers) once per second.
    while kill -0 "$pid" 2>/dev/null; do
        # pgrep exits with 1 when a process has no children; that must not end the script.
        children="$(pgrep -P "$pid" || true)"
        pids="$pid $children"
        for child in $children; do pids="$pids $(pgrep -P "$child" || true)"; done
        rss=$(ps -o rss= -p "$(echo $pids | tr ' \n' ',,')" 2>/dev/null | awk '{s+=$1} END {print s+0}' || true)
        [ "$rss" -gt "$peak" ] && peak=$rss
        sleep 1
    done
    set +e; wait "$pid"; code=$?; set -e
    if [ "$code" -gt 1 ]; then
        echo "run $name failed with exit code $code" >&2
        exit 2
    fi
    # Keep the stored reports free of this machine's paths.
    php -r 'file_put_contents($argv[1], str_replace($argv[2] . "/", "", file_get_contents($argv[1])));' "$out/$name.json" "$root"
    if grep -qF "$root/" "$out/$name.json"; then
        echo "run $name: $root is still in the report" >&2
        exit 2
    fi
    printf '{"run": "%s", "project": "%s", "paths": "%s", "toolCommit": "%s", "exitCode": %d, "wallSeconds": %d, "peakRssMb": %d, "date": "%s"}\n' \
        "$name" "$project" "$paths" "$commit" "$code" $(( $(date +%s) - start )) $(( peak / 1024 )) "$(date +%F)" > "$out/$name.meta.json"
    cat "$out/$name.meta.json"
done
