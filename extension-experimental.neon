# PHP rules that calibration (docs/calibration.md) moved to experimental. They are off by
# default: include this file in your phpstan.neon to opt in. magento-perf-check always
# includes it and enables these rules only when magento-perf-check.neon says so.
services:
    -
        class: Silin\MagentoPerfCheck\PhpStan\Rule\GetFirstItemWithoutLimitRule
        arguments:
            reportUntypedReceivers: %magentoPerf.reportUntypedReceivers%
        tags:
            - phpstan.rules.rule
    -
        class: Silin\MagentoPerfCheck\PhpStan\WebapiConstructorCollector
        tags:
            - phpstan.collector

rules:
    - Silin\MagentoPerfCheck\PhpStan\Rule\ConstructorWorkRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\SessionDataInBlockRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\ResolverQueryRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\ResolverCollectionLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\UserValueInHttpContextRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\ProductUrlInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\AttributeTextInLoopRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\SelectAllAttributesRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\HotRenderPluginRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\EagerCommandDependencyRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\UnpagedBatchCollectionRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\RepeatedScriptFunctionRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\UnusedViewModelRule
    - Silin\MagentoPerfCheck\PhpStan\Rule\WebapiConstructorParameterRule
