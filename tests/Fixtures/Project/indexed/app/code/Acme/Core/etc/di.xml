<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Acme\Promo\Block\Banner">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
            <argument name="title" xsi:type="string">Banner</argument>
        </arguments>
    </type>
    <virtualType name="Acme\Promo\Model\VirtualExporter" type="Acme\Promo\Model\Exporter">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </virtualType>
    <virtualType name="Acme\Promo\Resolver\VirtualBrand" type="Acme\Promo\Resolver\BaseOfVirtualBrand"/>
    <type name="Magento\Framework\View\Element\Template">
        <plugin name="acme_on_template" type="Acme\Render\OnTemplate"/>
    </type>
    <type name="Magento\Framework\View\Layout">
        <plugin name="acme_on_layout" type="Acme\Render\OnLayout"/>
    </type>
    <type name="Magento\Catalog\Block\Product\View">
        <plugin name="acme_on_specific" type="Acme\Render\OnSpecificBlock"/>
    </type>
    <type name="Magento\Framework\View\Element\AbstractBlock">
        <plugin name="acme_disabled" type="Acme\Render\Disabled" disabled="true"/>
        <plugin name="acme_disabled_elsewhere" disabled="true"/>
    </type>
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="acme_cart" type="Acme\Promo\Plugin\CartPlugin"/>
        <plugin name="acme_price" type="Acme\Promo\Model\PriceModifier"/>
    </type>
</config>
