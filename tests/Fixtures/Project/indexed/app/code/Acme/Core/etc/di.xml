<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Acme\Promo\Block\Banner">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
            <argument name="title" xsi:type="string">Banner</argument>
        </arguments>
    </type>
    <virtualType name="Acme\Promo\Model\VirtualExporter" type="Acme\Promo\Model\Exporter">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Checkout\Model\Cart">
        <plugin name="acme_cart" type="Acme\Promo\Plugin\CartPlugin"/>
        <plugin name="acme_price" type="Acme\Promo\Model\PriceModifier"/>
    </type>
</config>
