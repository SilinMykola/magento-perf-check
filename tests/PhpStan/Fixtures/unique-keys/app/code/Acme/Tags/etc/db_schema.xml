<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="acme_tag_order" resource="default">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="label_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ACME_TAG_ORDER_LABEL_ID_ORDER_ID">
            <column name="label_id"/>
            <column name="order_id"/>
        </constraint>
        <index referenceId="ACME_TAG_ORDER_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
    <table name="acme_tag_note" resource="default">
        <column xsi:type="varchar" name="code" nullable="false" length="32"/>
        <column xsi:type="int" name="store_id" unsigned="true" nullable="false"/>
        <constraint xsi:type="unique" referenceId="ACME_TAG_NOTE_CODE">
            <column name="code"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ACME_TAG_NOTE_STORE">
            <column name="store_id"/>
        </constraint>
    </table>
</schema>
